    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst content = {};\nlet imagePrompt = '';\n\nfor (const item of items) {\n  const d = item.json;\n  const platform = d.platform;\n  if (!platform) continue;\n  if (platform === 'instagram') {\n    content.instagram = { caption: d.caption || '', hashtags: d.hashtags || '' };\n    imagePrompt = d.image_prompt || '';\n  } else if (platform === 'facebook') {\n    content.facebook = { post: d.post || '' };\n  } else if (platform === 'linkedin') {\n    content.linkedin = { post: d.post || '' };\n  }\n}\n\n// Get platforms from webhook, fallback to deriving from content keys\nlet platforms = [];\ntry {\n  platforms =$('Webhook').first().json.body.platforms || [];\n} catch(e) {\n  platforms = [];\n}\n\nif (!platforms || platforms.length === 0) {\n  platforms = Object.keys(content);\n}\n\nreturn [{ json: { content, image_prompt: imagePrompt, platforms } }];"
      },
