        "responseBody": "=<!DOCTYPE html>\n<html>\n<head>\n  <title>Review Your Post</title>\n  <style>\n    body { font-family: Arial, sans-serif; max-width: 640px; margin: 40px auto; padding: 20px; background: #f0f0f0; }\n    h2 { color: #222; }\n    img { width: 100%; border-radius: 12px; margin: 20px 0; display: block; }\n    .buttons { display: flex; gap: 15px; margin-top: 25px; }\n    .btn { flex: 1; padding: 16px; font-size: 18px; border: none; border-radius: 10px; cursor: pointer; font-weight: bold; text-align: center; text-decoration: none; display: block; }\n    .approve { background: #28a745; color: white; }\n    .reject  { background: #dc3545; color: white; }\n  </style>\n</head>\n<body>\n  <h2>Review Your Post</h2>\n  <img src=\"{{ $('Prepare Post Data').item.json.image_url }}\" />\n  {{ $('Prepare Post Data').item.json.preview_html }}\n  <div class=\"buttons\">\n    <a class=\"btn approve\" href=\"{{ $execution.resumeUrl }}\">✅ POST IT</a>\n    <a class=\"btn reject\" href=\"javascript:window.close()\">❌ REJECT</a>\n  </div>\n</body>\n</html>",
