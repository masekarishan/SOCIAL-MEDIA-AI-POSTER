    {
      "parameters": {
        "jsCode": "const data      = $('Combine Results1').first().json;\nconst platforms = data.platforms || [];\nconst content   = data.content   || {};\nconst imageUrl  = `https://image.pollinations.ai/prompt/${encodeURIComponent(data.image_prompt)}?width=1080&height=1080&nologo=true`;\n\nconst colors = { instagram: '#e1306c', facebook: '#1877f2', linkedin: '#0a66c2' };\nconst names  = { instagram: 'Instagram', facebook: 'Facebook', linkedin: 'LinkedIn' };\n\nlet previewHtml = '';\nfor (const platform of platforms) {\n  if (!content[platform]) continue;\n  const c    = content[platform];\n  const text = c.caption\n    ? c.caption + '\\n\\n' + (Array.isArray(c.hashtags) ? c.hashtags.join(' ') : (c.hashtags || ''))\n    : (c.post || '');\n  previewHtml += `<div style=\"border-left:4px solid ${colors[platform]};background:white;padding:15px;border-radius:8px;margin:12px 0\">\n    <div style=\"font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:1px;color:${colors[platform]};margin-bottom:8px\">${names[platform]}</div>\n    <div style=\"font-size:14px;line-height:1.7;white-space:pre-wrap;color:#333\">${text}</div>\n  </div>`;\n}\n\nreturn [{ json: { image_url: imageUrl, platforms, content, preview_html: previewHtml } }];"
      },
