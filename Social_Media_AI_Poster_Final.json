      "parameters": {
        "jsCode": "// Try multiple sources for the data\nlet platforms = [];\nlet content = {};\nlet imageUrl = '';\n\n// Try Prepare Post Data\ntry {\n  const d = $('Prepare Post Data').first().json;\n  if (d && d.platforms && d.platforms.length > 0) {\n    platforms = d.platforms;\n    content   = d.content   || {};\n    imageUrl  = d.image_url || '';\n  }\n} catch(e) {}\n\n// Fallback: try Combine Results directly\nif (platforms.length === 0) {\n  try {\n    const d = $('Combine Results1').first().json;\n    if (d) {\n      content   = d.content || {};\n      platforms = (d.platforms && d.platforms.length > 0) ? d.platforms : Object.keys(content);\n      imageUrl  = `https://image.pollinations.ai/prompt/${encodeURIComponent(d.image_prompt || '')}?width=1080&height=1080&nologo=true`;\n    }\n  } catch(e) {}\n}\n\n// Final fallback: derive from content keys\nif (platforms.length === 0) {\n  platforms = Object.keys(content);\n}\n\n// Absolute fallback\nif (platforms.length === 0) {\n  platforms = ['instagram'];\n}\n\nreturn platforms.map(platform => ({\n  json: { platform, content: content[platform] || {}, image_url: imageUrl }\n}));"
      },
